# Copy to .env for local development. Every value has a default in internal/config.
MESSARIO_ADDR=:8080
MESSARIO_DATABASE_URL=postgres://messario:messario@localhost:5432/messario?sslmode=disable
MESSARIO_PUBLIC_URL=http://localhost:8080
MESSARIO_COOKIE_SECURE=false
MESSARIO_SESSION_TTL=720h
MESSARIO_LOG_LEVEL=info

# Optional: send traces, metrics and logs to Vindice (team observability platform)
# MESSARIO_VINDICE_ENDPOINT=http://vindice-host:4318
# MESSARIO_VINDICE_API_KEY=vdc_...
# MESSARIO_ENVIRONMENT=production
