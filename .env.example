# Copy to .env for local development. Every value has a default in internal/config.
NUNTIO_ADDR=:8080
NUNTIO_DATABASE_URL=postgres://nuntio:nuntio@localhost:5432/nuntio?sslmode=disable
NUNTIO_PUBLIC_URL=http://localhost:8080
NUNTIO_COOKIE_SECURE=false
NUNTIO_SESSION_TTL=720h
NUNTIO_LOG_LEVEL=info

# Optional: send traces, metrics and logs to Vindice (team observability platform)
# NUNTIO_VINDICE_ENDPOINT=http://vindice-host:4318
# NUNTIO_VINDICE_API_KEY=vdc_...
# NUNTIO_ENVIRONMENT=production
