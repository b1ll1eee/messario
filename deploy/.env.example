# Copy to deploy/.env and fill in. Never commit deploy/.env.
NUNTIO_DOMAIN=chat.example.co.th
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# License key from your vendor (leave empty for the community edition).
NUNTIO_LICENSE=

# Optional
NUNTIO_ENVIRONMENT=production
NUNTIO_MAX_FILE_MB=25
